{
  "output_dir": "",
  "csv": {
    "separator": ";",
    "encoding": "utf-8",
    "filename_pattern": "{export_ref}_everyParts.csv",
    "columns": [
      {
        "header": "product",
        "source": "{export_ref}"
      },
      {
        "header": "type",
        "source": "{type_app}"
      },
      {
        "header": "manufacturer",
        "source": "{manufacturer}"
      },
      {
        "header": "modele_name",
        "source": "{modele_complet}"
      },
      {
        "header": "reference_modele",
        "source": "{ref_modele}"
      },
      {
        "header": "commercial_reference",
        "source": "{commercial_ref}"
      }
    ]
  },
  "html": {
    "brands": {
      "link_template": "<a href=\"#{marque}\">{marque}</a>",
      "separator": " ",
      "char_limit": 195000
    },
    "details": {
      "brand_header_template": "<div id=\"{marque}\"><b><u>{marque}</u></b></div>",
      "model_line_template": "<div>{modele_complet}</div>",
      "group_separator": "<div>&nbsp;</div>",
      "char_limit": 195000
    },
    "details_profiles": [
      {
        "name": "Format standard",
        "brand_header_template": "<div id=\"{marque}\"><b><u>{marque}</u></b></div>",
        "model_line_template": "<div>{modele_complet}</div>",
        "group_separator": "<div>&nbsp;</div>",
        "char_limit": 195000
      }
    ],
    "details_default_profile": "Format standard"
  },
  "titre": {
    "profiles": [
      {
        "name": "Format standard",
        "template": "{libelle} pour {type} {marques} - {reference}",
        "max_marques": 4,
        "max_types": 3,
        "max_caracteres": 120,
        "separateur_marques": ", ",
        "dernier_separateur_marques": " et ",
        "separateur_types": ", ",
        "dernier_separateur_types": " et "
      }
    ],
    "default_profile": "Format standard"
  }
}
